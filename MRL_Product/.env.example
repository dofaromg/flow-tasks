PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.com

JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

DB_PATH=/app/storage/db.sqlite

ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_KEY
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Runtime acceptance / staging must use test. Switch to live only after merchant and commercial gates pass.
STRIPE_MODE=test
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET
# Optional today: one-time NT$299 checkout uses dynamic price_data rather than a fixed Price ID.
STRIPE_PRICE_ONCE=
# Required for subscription checkout.
STRIPE_PRICE_SUB=REPLACE_WITH_YOUR_SUB_PRICE_ID

ADMIN_KEY=REPLACE_WITH_ADMIN_KEY
LOG_LEVEL=info
