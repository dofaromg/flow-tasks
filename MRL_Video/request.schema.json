{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MRL_Video_Request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "MRL_Video_Request/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "original_name",
          "locator",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "maxLength": 48
          },
          "original_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "caption",
          "source_id"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "source_id": {
            "type": "string",
            "maxLength": 48
          },
          "duration": {
            "type": "number",
            "minimum": 2,
            "maximum": 20,
            "multipleOf": 0.001,
            "default": 8
          },
          "layout": {
            "enum": [
              "diagram",
              "steps",
              "quote"
            ],
            "default": "diagram"
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "profile": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ],
      "default": "landscape"
    },
    "music": {
      "type": "boolean",
      "default": true
    },
    "require_narration": {
      "type": "boolean",
      "default": false
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "template": {
      "enum": [
        "explainer",
        "tutorial",
        "release",
        "promo"
      ]
    }
  },
  "$comment": "Python validation additionally enforces total duration 30..60s, caption/source substring mapping, source hash, unique IDs and request budgets."
}
