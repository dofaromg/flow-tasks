{
  "openapi": "3.1.0",
  "info": {
    "title": "MRL Video private local API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7812"
    }
  ],
  "security": [
    {
      "MRLKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "MRLKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "VideoRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MRL_Video_Request/v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "title",
          "sources"
        ],
        "properties": {
          "schema": {
            "const": "MRL_Video_Request/v1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "original_name",
                "locator",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 48
                },
                "original_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "caption",
                "source_id"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "source_id": {
                  "type": "string",
                  "maxLength": 48
                },
                "duration": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 20,
                  "multipleOf": 0.001,
                  "default": 8
                },
                "layout": {
                  "enum": [
                    "diagram",
                    "steps",
                    "quote"
                  ],
                  "default": "diagram"
                },
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "narration": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              }
            }
          },
          "profile": {
            "enum": [
              "landscape",
              "portrait",
              "square"
            ],
            "default": "landscape"
          },
          "music": {
            "type": "boolean",
            "default": true
          },
          "require_narration": {
            "type": "boolean",
            "default": false
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "template": {
            "enum": [
              "explainer",
              "tutorial",
              "release",
              "promo"
            ]
          }
        },
        "$comment": "Python validation additionally enforces total duration 30..60s, caption/source substring mapping, source hash, unique IDs and request budgets."
      },
      "LongFilmRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MRL_LongFilm_Request/v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "title",
          "sources",
          "scenes",
          "target_seconds"
        ],
        "properties": {
          "schema": {
            "const": "MRL_LongFilm_Request/v1"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "original_name",
                "locator",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$",
                  "maxLength": 48
                },
                "original_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 600,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "caption",
                "source_id",
                "clip",
                "duration"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "source_id": {
                  "type": "string",
                  "maxLength": 48
                },
                "duration": {
                  "type": "number",
                  "minimum": 2,
                  "maximum": 120
                },
                "clip": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "in_seconds": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "allow_silent": {
                  "type": "boolean",
                  "default": false
                },
                "transition": {
                  "enum": [
                    "cut",
                    "fade"
                  ],
                  "default": "cut"
                }
              }
            }
          },
          "profile": {
            "enum": [
              "landscape",
              "portrait",
              "square",
              "fullhd",
              "uhd"
            ],
            "default": "landscape"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "quality": {
            "enum": [
              "draft",
              "fullhd",
              "uhd"
            ],
            "default": "draft"
          },
          "target_seconds": {
            "type": "number",
            "minimum": 2,
            "maximum": 1200
          }
        },
        "$comment": "Python enforces 24 FPS frame alignment, exact duration sum, original source/caption mapping and relative local asset paths."
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Public process/worker liveness; not media dependency acceptance.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "security": []
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List latest 100 jobs.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        }
      },
      "post": {
        "summary": "Submit strict JSON request; optional Idempotency-Key.",
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/VideoRequest"
                  },
                  {
                    "$ref": "#/components/schemas/LongFilmRequest"
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/api/templates": {
      "get": {
        "summary": "List template and profile capabilities.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        }
      }
    },
    "/api/chain": {
      "get": {
        "summary": "Verify local event hash chain.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "summary": "Load job status.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/jobs/{job_id}/request": {
      "get": {
        "summary": "Read saved version request.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/jobs/{job_id}/events": {
      "get": {
        "summary": "Read ordered job events.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/jobs/{job_id}/branch": {
      "post": {
        "summary": "Create child version; full revised request required.",
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/VideoRequest"
                  },
                  {
                    "$ref": "#/components/schemas/LongFilmRequest"
                  }
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/api/jobs/{job_id}/cancel": {
      "post": {
        "summary": "Request cancellation; JSON object body required.",
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ]
      }
    },
    "/api/diff/{left}/{right}": {
      "get": {
        "summary": "Compare two preserved request versions.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "left",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "right",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/artifacts/{job_id}/{name}": {
      "get": {
        "summary": "Download successful allowlisted media/package with byte-range support.",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or integrity failure"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Unavailable resource"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/jobs/{job_id}/segments": {
      "get": {
        "summary": "Persistent segment progress and cache dependencies",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Segment queue rows"
          }
        }
      }
    }
  }
}
