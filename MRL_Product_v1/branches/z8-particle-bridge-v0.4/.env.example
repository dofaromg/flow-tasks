# DL580 local listener
Z8_BRIDGE_HOST=127.0.0.1
Z8_BRIDGE_PORT=8788
Z8_BRIDGE_MODE=dry-run
Z8_LEDGER_PATH=./data/z8-particle-ledger.jsonl

# Local control and device authentication. Set unique values on DL580.
Z8_CONTROL_TOKEN=
Z8_DEVICE_SHARED_SECRET=

# Runtime selection
Z8_AI_ENGINE=qwen-main
Z8_VOICE_MODE=chatgpt
QWEN_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
QWEN_MODEL=qwen-main
MUSE_ENDPOINT=http://127.0.0.1:1235/v1/chat/completions
MUSE_MODEL=meta/muse-glimmer
LOCAL_STT_ENDPOINT=http://127.0.0.1:9001/v1/transcribe
CHATGPT_VOICE_ENDPOINT=http://127.0.0.1:9002/v1/speech
LINE_VOICE_ENDPOINT=http://127.0.0.1:9003/v1/speech

# Actual LINE Messaging API. Never commit real values.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_BASE=https://api.line.me

# LINE_VOICE_ENDPOINT must return an HTTPS audio_url plus duration_ms. LINE is
# the voice-message transport; it does not synthesize speech by itself.
