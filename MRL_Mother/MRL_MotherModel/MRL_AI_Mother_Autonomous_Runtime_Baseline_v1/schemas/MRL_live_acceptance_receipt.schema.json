{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MRL_live_acceptance_receipt.schema.json",
  "title": "MRL AI Mother Live Acceptance Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonical_id",
    "origin_signature",
    "git_head",
    "hardware_id",
    "runtime_id",
    "backend",
    "model",
    "model_endpoint",
    "model_release_id",
    "model_release_manifest_sha256",
    "model_artifact_sha256",
    "model_artifact_size_bytes",
    "model_sha256_verified",
    "health_ready",
    "memory_chain_head",
    "evidence_chain_head",
    "passport_hash",
    "return_anchor",
    "evidence_ref",
    "request_sha256",
    "result_sha256",
    "external_model_disconnected",
    "accepted_at",
    "operator_id",
    "acceptance_gate"
  ],
  "properties": {
    "schema": {"const": "MRL_AI_Mother_Live_Acceptance_v1"},
    "canonical_id": {"const": "MRL_AI_Mother_Autonomous_Runtime_Baseline_v1"},
    "origin_signature": {"const": "MrLiouWord"},
    "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hardware_id": {"type": "string", "pattern": "^MRL_[A-Za-z0-9_.:-]+$"},
    "runtime_id": {"type": "string", "minLength": 1},
    "backend": {"enum": ["ollama", "llamacpp"]},
    "model": {"type": "string", "minLength": 1},
    "model_endpoint": {"type": "string", "minLength": 1},
    "model_release_id": {"type": "string", "pattern": "^MRL_[A-Za-z0-9_.:-]+$"},
    "model_release_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_artifact_size_bytes": {"type": "integer", "minimum": 1},
    "model_sha256_verified": {"const": true},
    "health_ready": {"const": true},
    "memory_chain_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_chain_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "passport_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "return_anchor": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ref": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_model_disconnected": {"const": true},
    "accepted_at": {"type": "string", "format": "date-time"},
    "operator_id": {"type": "string", "pattern": "^MRL_[A-Za-z0-9_.:-]+$"},
    "acceptance_gate": {"const": "MRL_AI_MOTHER_AUTONOMOUS_RUNTIME_ACCEPTANCE_PASS"}
  }
}
