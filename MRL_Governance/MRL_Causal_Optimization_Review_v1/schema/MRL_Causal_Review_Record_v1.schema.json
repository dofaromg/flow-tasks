{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MRL Causal Review Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "origin_signature",
    "original_request",
    "actual_action",
    "evidence_references",
    "causal_order",
    "status",
    "node_attestations"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "origin_signature": {"const": "MrLiouWord"},
    "original_request": {"type": "string", "minLength": 1},
    "actual_action": {"type": "string", "minLength": 1},
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "divergence": {"type": ["string", "null"]},
    "causal_order": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "correction": {"type": ["string", "null"]},
    "status": {
      "enum": ["FACT", "INFERENCE", "UNRESOLVED", "CORRECTED"]
    },
    "supersedes_record_id": {"type": ["string", "null"]},
    "node_attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "decision",
          "evidence_hash",
          "signature_scheme",
          "signature",
          "signed_at"
        ],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["FACT", "INFERENCE", "UNRESOLVED", "CORRECTED"]},
          "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "signature_scheme": {"const": "SHA256_RECEIPT_V1"},
          "signature": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "signed_at": {"type": "string", "format": "date-time"},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "consensus_state": {
      "enum": ["CONSENSUS", "PARTIAL_CONSENSUS", "DISSENT_PRESERVED", "UNRESOLVED"]
    }
  }
}
