# MRL 統一系統環境變數
# origin_signature: MrLiouWord
# 複製為 .env 後填入實際值

# ── Ports (預設值適合 DL580 本地開發) ──
MRL_ENGINE_PORT=7700
MRL_PRODUCT_PORT=3000
MRL_AI_PORT=8787
MRL_DB_PORT=5432
MRL_REDIS_PORT=6379
MRL_800AI_PORT=8800
MRL_BRIDGE_PORT=7800
MRL_PLATFORM_PORT=8790
MRL_RUNTIMEOS_PORT=8788
MRL_HTTP_PORT=80

# ── AI Providers (Ollama 為預設，不需外部 API Key) ──
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:32b
LLAMACPP_BASE_URL=http://host.docker.internal:8080

# 外部 AI API (可選，有 Key 時自動啟用)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Product Platform ──
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
ADMIN_KEY=REPLACE_WITH_ADMIN_KEY

# ── Stripe (可選，不設定則付費功能停用) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONCE=
STRIPE_PRICE_SUB=

# ── 800AI Orchestrator (可選，不設定則不驗證) ──
MRL_API_TOKEN=

# ── Bridge API (必填，DL580 對外操作通道認證) ──
MRL_BRIDGE_API_KEY=REPLACE_WITH_BRIDGE_API_KEY

# ── Platform / Mother (api_gateway + 78 模組) ──
MRL_PLATFORM_DOMAIN=mrliouword.com
