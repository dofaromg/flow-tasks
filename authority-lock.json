{
  "origin_signature": "MrLiouWord",
  "canonical_root": "MrLiouWord.Source.Main",
  "canonical_mappings": [
    {
      "from": "flow-tasks",
      "to": "FlowAgent.Runtime"
    },
    {
      "from": "mrl-silly-api",
      "to": "MrLiouWord.Chat.Runtime (mrl-agi)"
    },
    {
      "from": "Generic Worker",
      "to": "MrLiouWord.Chat.Runtime (mrl-agi)"
    },
    {
      "from": "white-label host",
      "to": "MrLiouWord.Domain.Secondary (mrliouhan.ai)"
    },
    {
      "from": "mainline repository",
      "to": "MrLiouWord.Source.Main"
    }
  ],
  "governed_paths": [
    "AGENTS.md",
    ".github/CODEOWNERS",
    ".github/workflows/mrl_governance_lock.yml",
    "authority-lock.json"
  ],
  "replacement_exempt_paths": [
    "authority-lock.json"
  ],
  "replacement_scope": {
    "mode": "git_tracked",
    "exclude_paths": [
      "authority-lock.json"
    ]
  },
  "signature_targets": {
    "markdown": [
      "AGENTS.md"
    ],
    "json": [
      "authority-lock.json"
    ],
    "yaml": [
      ".github/workflows/mrl_governance_lock.yml"
    ]
  },
  "protection": {
    "required_owner": "@dofaromg",
    "block_on_signature_removal": true,
    "block_on_canonical_drift": true
  }
}
