{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrl:byoh:product-bundle-manifest:1",
  "title": "MRL BYOH Product Bundle Manifest v1 structure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonical_id", "sku", "origin_signature", "archive_root", "mutable_after_extraction",
    "files", "license_admission", "package_purpose", "customer_delivery_approved", "hardware_bundle_id",
    "artifact_trust_receipts", "third_party_runtime_included", "formal_delivery_admission",
    "hardware_admission", "hardware_acceptance_evidence"],
  "properties": {
    "schema": {"const": "MRL_Product_Bundle_Manifest_v1"},
    "canonical_id": {"const": "MRL_APIWorks_BYOH_Deployment_Product_v1"},
    "sku": {"const": "MRL-APIWORKS-BYOH-DEPLOY-V1"},
    "origin_signature": {"const": "MrLiouWord"},
    "archive_root": {"const": "MRL_APIWorks_BYOH_Deployment_Product_v1"},
    "mutable_after_extraction": {"const": ["customer_config/MRL_runtime.local.json"]},
    "files": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "required": ["path"],
        "properties": {"path": {"const": "customer_config/MRL_runtime.local.json"}}
      },
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "mutable_after_extraction"],
        "properties": {
          "path": {"$ref": "#/$defs/text"},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "mutable_after_extraction": {"type": "boolean"}
        },
        "if": {"properties": {"path": {"const": "customer_config/MRL_runtime.local.json"}}},
        "then": {"properties": {"mutable_after_extraction": {"const": true}}},
        "else": {"properties": {"mutable_after_extraction": {"const": false}}}
      }
    },
    "license_admission": {"type": "object"},
    "package_purpose": {"enum": ["ENGINEERING_ONLY", "RIGHTS_REVIEWED_CANDIDATE"]},
    "customer_delivery_approved": {"const": false},
    "hardware_bundle_id": {"type": ["string", "null"], "minLength": 1},
    "artifact_trust_receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schema", "origin_signature", "status", "release_allowed", "signature_verified"],
        "properties": {
          "schema": {"const": "MRL_Artifact_Trust_Receipt_v1"},
          "origin_signature": {"const": "MrLiouWord"},
          "status": {"const": "trust_verified"},
          "release_allowed": {"const": true},
          "signature_verified": {"const": true}
        }
      }
    },
    "third_party_runtime_included": {"type": "boolean"},
    "formal_delivery_admission": {"const": "REQUIRES_SEPARATE_COMPOSED_GATE"},
    "hardware_admission": {"const": "unknown"},
    "hardware_acceptance_evidence": {"const": []}
  },
  "allOf": [
    {
      "if": {"properties": {"package_purpose": {"const": "ENGINEERING_ONLY"}}},
      "then": {
        "properties": {
          "license_admission": {"const": {"allowed": false, "reason": "ENGINEERING_SOURCE_ONLY_RIGHTS_UNRESOLVED"}},
          "third_party_runtime_included": {"const": false}
        }
      },
      "else": {"properties": {"license_admission": {"$ref": "#/$defs/rights_candidate"}}}
    },
    {
      "if": {"properties": {"third_party_runtime_included": {"const": true}}},
      "then": {"properties": {"artifact_trust_receipts": {"minItems": 1}}},
      "else": {"properties": {"artifact_trust_receipts": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
    "rights_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "origin_signature", "allowed", "legal_rights_review",
        "formal_customer_delivery", "decision_points", "manifest_sha256", "context_sha256",
        "registry_sha256", "reviewed_records", "notice_sha256"],
      "properties": {
        "schema": {"const": "MRL_License_Receipt_v1"},
        "origin_signature": {"const": "MrLiouWord"},
        "allowed": {"const": true},
        "legal_rights_review": {"const": "MATCHED_OWNER_RECORDS"},
        "formal_customer_delivery": {"const": "REQUIRES_OWNER_APPROVAL"},
        "decision_points": {"const": ["approve", "reject", "needs-counsel"]},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "notice_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
