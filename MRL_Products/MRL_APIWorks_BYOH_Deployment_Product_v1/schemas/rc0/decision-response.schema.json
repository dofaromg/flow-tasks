{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrl:byoh:decision-response:0.1-rc0",
  "title": "MRL BYOH Decision Response v0.1-RC0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "resolved_model", "answers", "route_receipt_id", "canonical_authority", "origin_signature"],
  "properties": {
    "contract_version": { "const": "0.1-RC0" },
    "request_id": { "type": "string", "minLength": 1 },
    "resolved_model": { "type": "string", "minLength": 1 },
    "resolved_model_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "answers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/answer" }
    },
    "calibration_revision": { "type": ["string", "null"] },
    "low_confidence_action": { "enum": ["none", "reject", "human-review", "fallback-model"] },
    "route_receipt_id": { "type": "string", "minLength": 1 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "latency_ms": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "canonical_authority": { "const": "Mr.liou" },
    "origin_signature": { "const": "MrLiouWord" }
  },
  "$defs": {
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "choice", "confidence", "probabilities"],
          "properties": {
            "type": { "const": "choice" },
            "choice": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "probabilities": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "score", "confidence", "probabilities"],
          "properties": {
            "type": { "const": "score" },
            "score": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "probabilities": { "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "noul", "confidence"],
          "properties": {
            "type": { "const": "noul" },
            "noul": { "type": "number", "minimum": 0, "maximum": 1 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    }
  }
}
