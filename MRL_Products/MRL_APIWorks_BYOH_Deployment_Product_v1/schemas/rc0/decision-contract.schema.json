{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mrl:byoh:decision-request:0.1-rc0",
  "title": "MRL BYOH Decision Request v0.1-RC0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "model", "state", "questions", "provenance"],
  "properties": {
    "contract_version": { "const": "0.1-RC0" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "idempotency_key": { "type": ["string", "null"], "maxLength": 256 },
    "model": { "type": "string", "minLength": 1, "maxLength": 256 },
    "state": { "type": ["object", "array", "string", "number", "boolean"] },
    "media": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference", "sha256", "data_classification"],
        "properties": {
          "type": { "enum": ["image", "video", "audio"] },
          "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] }
        }
      }
    },
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]{1,128}$" },
      "additionalProperties": { "$ref": "#/$defs/question" }
    },
    "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "on_low_confidence": { "enum": ["reject", "human-review", "fallback-model"] },
    "deadline_ms": { "type": ["integer", "null"], "minimum": 1, "maximum": 3600000 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_authority", "origin_signature", "source_receipt_ids"],
      "properties": {
        "canonical_authority": { "const": "Mr.liou" },
        "origin_signature": { "const": "MrLiouWord" },
        "source_receipt_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "$defs": {
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": { "const": "choice" },
            "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "criteria": { "type": "object", "minProperties": 2, "maxProperties": 128, "additionalProperties": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": { "const": "score" },
            "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "criteria": { "type": "array", "minItems": 2, "maxItems": 128, "uniqueItems": true, "items": { "type": "string" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions"],
          "properties": {
            "type": { "const": "noul" },
            "instructions": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      ]
    }
  }
}
